# Content Pipeline — API keys
# Copy to .env locally, or set as GitHub Actions repo secrets of the same names.

# Narration: Kokoro (tts_kokoro.py) needs NO key — it's free and self-hosted,
# voice is set in code (default am_liam). Nothing to fill in here for it.
# Optional override, only if you want a different Kokoro voice than the code default:
# KOKORO_VOICE=am_liam

# aistudio.google.com/apikey
GEMINI_API_KEY=

# publish.buffer.com/settings/api
BUFFER_API_KEY=

# Cloudflare R2 -- dash.cloudflare.com -> R2 Object Storage -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# console.cloud.google.com -> APIs & Services -> Credentials (YouTube Data API v3)
YOUTUBE_API_KEY=

# Optional — only used if tts_elevenlabs.py's fallback path is ever called
# instead of Kokoro (not the default; see tts_kokoro.py / make_short.py):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

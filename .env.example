# Content Pipeline — API keys
# Copy to .env locally, or set as GitHub Actions repo secrets of the same names.

# elevenlabs.io -> Settings -> API Keys
ELEVENLABS_API_KEY=

# elevenlabs.io -> Voices -> pick one -> copy its Voice ID
ELEVENLABS_VOICE_ID=

# aistudio.google.com/apikey
GEMINI_API_KEY=

# publish.buffer.com/settings/api
BUFFER_API_KEY=

# Cloudflare R2 -- dash.cloudflare.com -> R2 Object Storage -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# console.cloud.google.com -> APIs & Services -> Credentials (YouTube Data API v3)
YOUTUBE_API_KEY=

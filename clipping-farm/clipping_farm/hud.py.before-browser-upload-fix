def _json(handler, code, payload):
    body=json.dumps(payload,ensure_ascii=False).encode()
    handler.send_response(code); handler.send_header("Content-Type","application/json; charset=utf-8")
    handler.send_header("Content-Length",str(len(body))); handler.end_headers(); handler.wfile.write(body)

class HUDHandler(BaseHTTPRequestHandler):
    db_path=None
    source_id=None
    active_runs=set()

    def _body_json(self):
        n=int(self.headers.get("Content-Length","0")); raw=self.rfile.read(n)
        return json.loads(raw or b"{}")

    def do_GET(self):
        parsed=urlparse(self.path)
        if parsed.path=="/":
            body=HTML.encode(); self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8")
            self.send_header("Content-Length",str(len(body))); self.end_headers(); self.wfile.write(body); return
        if parsed.path=="/api/snapshot":
            params=parse_qs(parsed.query)
            source_id=params.get("source_id",[self.source_id])[0]
            db=DB(self.db_path); _json(self,200,db.run_snapshot(source_id)); return
        self.send_error(404)

    def do_POST(self):
        parsed = urlparse(self.path)

        if parsed.path == "/api/upload":
            try:
                length = int(self.headers.get("Content-Length", "0"))
                content_type = self.headers.get("Content-Type", "")
                body = self.rfile.read(length)

                if "multipart/form-data" not in content_type:
                    _json(self, 400, {"error": "Expected multipart/form-data"})
                    return

                raw = (
                    ("Content-Type: " + content_type +
                     "\r\nMIME-Version: 1.0\r\n\r\n").encode()
                    + body
                )

                msg = BytesParser(policy=default).parsebytes(raw)

                filename = None
                payload = None

                for part in msg.walk():
                    name = part.get_filename()
                    if name:
                        data = part.get_payload(decode=True)
                        if data:
                            filename = _Path(name).name
                            payload = data
                            break

                if not filename or not payload:
                    _json(self, 400, {"error": "No video file received"})
                    return

                db = DB(self.db_path)

                sid = "upload-" + uuid.uuid4().hex[:12]

                root = (
                    _Path(self.db_path).resolve().parent
                    / "clipping_farm_work"
                    / sid
                )
                root.mkdir(parents=True, exist_ok=True)

                source_path = root / filename
                source_path.write_bytes(payload)

                db.set_rights(
                    sid,
                    "AUTHORISED",
                    {"basis": "operator-uploaded local source"},
                )

                ingested = SourceIngestor(db).ingest_file(
                    Source(
                        sid,
                        str(source_path),
                        "file",
                        {"purpose": "operator-uploaded video"},
                    )
                )

                HUDHandler.source_id = sid

                print(
                    "UPLOAD REGISTERED:",
                    sid,
                    ingested["asset_id"],
                )

                _json(
                    self,
                    200,
                    {
                        "source_id": sid,
                        "asset_id": ingested["asset_id"],
                        "filename": filename,
                        "library_path": ingested["library_path"],
                        "rights_state": "AUTHORISED",
                        "state": "READY",
                    },
                )

            except Exception as exc:
                print("UPLOAD ERROR:", repr(exc))
                _json(
                    self,
                    500,
                    {"error": f"{type(exc).__name__}: {exc}"},
                )
            return

        if parsed.path == "/api/run":
            try:
                data = self._body_json()
                sid = data.get("source_id") or HUDHandler.source_id

                if not sid:
                    _json(self, 400, {"error": "No source_id"})
                    return

                db = DB(self.db_path)

                row = db.cx.execute(
                    """
                    SELECT *
                    FROM assets
                    WHERE source_id=?
                    ORDER BY created_at DESC
                    LIMIT 1
                    """,
                    (sid,),
                ).fetchone()

                if not row:
                    _json(self, 404, {"error": "No asset registered"})
                    return

                asset = dict(row)

                if asset.get("rights_state") != "AUTHORISED":
                    _json(self, 403, {"error": "Asset is not authorised"})
                    return

                local_path = asset.get("local_path")
                if not local_path or not _Path(local_path).exists():
                    _json(self, 404, {"error": "Asset file not found"})
                    return

                if sid in HUDHandler.active_runs:
                    _json(self, 200, {
                        "source_id": sid,
                        "state": "RUNNING",
                        "already_running": True,
                    })
                    return

                budget = float(data.get("budget", 0) or 0)
                mode = str(data.get("mode", "FREE-FIRST") or "FREE-FIRST")

                plan = ClippingPipeline(db).create(
                    sid,
                    source_path=local_path,
                    budget=budget,
                    mode=mode,
                    asset_id=asset["asset_id"],
                )

                HUDHandler.source_id = sid
                HUDHandler.active_runs.add(sid)

                job_ids = plan.jobs
                db_path = self.db_path

                def worker():
                    run_db = None
                    try:
                        run_db = DB(db_path)

                        result = PipelineRunner(
                            run_db,
                            LocalHandlers(run_db).handlers(),
                            capabilities=TASKS,
                        ).run(
                            plan.source_id,
                            job_ids,
                        )

                        print(
                            "BUILD 20.3:",
                            result.source_id,
                            result.state,
                            "processed=",
                            result.processed,
                        )

                    except Exception as exc:
                        print("BUILD 20.3 ERROR:", repr(exc))

                        if run_db is not None:
                            try:
                                for job_id in job_ids.values():
                                    run_db.cx.execute(
                                        """
                                        UPDATE jobs
                                        SET state='DEAD_LETTER', error=?
                                        WHERE id=?
                                        AND state NOT IN
                                            ('COMPLETE','DEAD_LETTER')
                                        """,
                                        (
                                            f"{type(exc).__name__}: {exc}",
                                            job_id,
                                        ),
                                    )
                                run_db.cx.commit()
                            except Exception as db_exc:
                                print(
                                    "BUILD FAILURE RECORD ERROR:",
                                    repr(db_exc),
                                )

                    finally:
                        HUDHandler.active_runs.discard(sid)

                threading.Thread(
                    target=worker,
                    name=f"clipping-farm-{sid}",
                    daemon=True,
                ).start()

                _json(
                    self,
                    202,
                    {
                        "source_id": sid,
                        "asset_id": asset["asset_id"],
                        "state": "RUNNING",
                        "jobs": job_ids,
                    },
                )

            except Exception as exc:
                print("RUN ERROR:", repr(exc))
                _json(
                    self,
                    500,
                    {"error": f"{type(exc).__name__}: {exc}"},
                )
            return

        _json(self, 404, {"error": "Unknown POST endpoint"})

    def log_message(self,*_): pass

def serve(db_path, source_id, host="127.0.0.1", port=8765):
    HUDHandler.db_path=db_path; HUDHandler.source_id=source_id
    server=ThreadingHTTPServer((host,port),HUDHandler)
    print(f"Clipping Farm HUD: http://{host}:{port}")
    print(f"Source/run: {source_id}")
    print("Press Ctrl-C to stop.")
    try: server.serve_forever()
    except KeyboardInterrupt: print("\nHUD stopped.")
    finally: server.server_close()


def _json(handler, code, payload):
    body=json.dumps(payload,ensure_ascii=False).encode()
    handler.send_response(code); handler.send_header("Content-Type","application/json; charset=utf-8")
    handler.send_header("Content-Length",str(len(body))); handler.end_headers(); handler.wfile.write(body)

class HUDHandler(BaseHTTPRequestHandler):
    db_path=None; source_id=None

    def _body_json(self):
        n=int(self.headers.get("Content-Length","0")); raw=self.rfile.read(n)
        return json.loads(raw or b"{}")

    def do_GET(self):
        parsed=urlparse(self.path)
        if parsed.path=="/":
            body=HTML.encode(); self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8")
            self.send_header("Content-Length",str(len(body))); self.end_headers(); self.wfile.write(body); return
        if parsed.path=="/api/snapshot":
            params=parse_qs(parsed.query)
            source_id=params.get("source_id",[self.source_id])[0]
            db=DB(self.db_path); _json(self,200,db.run_snapshot(source_id)); return
        self.send_error(404)

    def do_POST(self):
        try:
            parsed=urlparse(self.path)
            db=DB(self.db_path)
            if parsed.path=="/api/intake":
                data=self._body_json()
                purpose=data.get("purpose","reference")
                if data.get("local_path"):
                    source_id=f"hud:{uuid.uuid4().hex[:12]}"
                    db.set_rights(source_id,"AUTHORISED",{"basis":"explicit operator action in local HUD"})
                    result=SourceIngestor(db).ingest_file(Source(source_id,data["local_path"],"file",{"purpose":purpose}))
                    _json(self,200,result); return
                url=data.get("url")
                if not url: _json(self,400,{"error":"url or local_path required"}); return
                result=ReferenceInspector().persist(db,ReferenceInspector().inspect(url))
                # Create an asset at inspection time; acquisition remains gated.
                asset,_=db.create_asset(source_id=result["source_id"],source_url=url,source_type="url",
                    purpose=purpose,title=result["metadata"].get("title"),creator=result["metadata"].get("uploader"),
                    media_type="video",duration=result["metadata"].get("duration"),metadata=result["metadata"],provenance=result["provenance"])
                _json(self,200,{"source_id":result["source_id"],"asset_id":asset["asset_id"],"rights_state":"UNKNOWN","acquisition_state":"PENDING"}); return
            if parsed.path=="/api/authorise":
                data=self._body_json(); sid=data.get("source_id")
                if not sid: _json(self,400,{"error":"source_id required"}); return
                db.set_rights(sid,"AUTHORISED",{"basis":"explicit operator action in local HUD"})
                row=db.cx.execute("SELECT asset_id FROM assets WHERE source_id=?",(sid,)).fetchone()
                if row: db.update_asset(row["asset_id"],rights_state="AUTHORISED")
                _json(self,200,{"source_id":sid,"rights_state":"AUTHORISED"}); return
            if parsed.path=="/api/acquire":
                data=self._body_json(); sid=data.get("source_id")
                row=db.cx.execute("SELECT * FROM sources WHERE source_id=?",(sid,)).fetchone()
                if not row: _json(self,404,{"error":"source not found"}); return
                url=row["location"]; result=ReferenceDownloader().acquire(db,url,purpose=data.get("purpose","reference"))
                _json(self,200,result); return
            if parsed.path=="/api/complete_asset":
                data=self._body_json()
                sid=data.get("source_id")
                if not sid:
                    _json(self,400,{"error":"source_id required"}); return

                row=db.cx.execute(
                    "SELECT * FROM assets WHERE source_id=?",
                    (sid,)
                ).fetchone()

                if not row:
                    _json(self,404,{"error":"asset not found"}); return

                if row["rights_state"] != "AUTHORISED":
                    _json(self,403,{"error":"rights gate: asset must be authorised"}); return

                video=row["local_path"]
                if not video or not Path(video).exists():
                    _json(self,404,{"error":"local asset file not found"}); return

                import threading, uuid

                run_id="HUD-"+uuid.uuid4().hex[:12]

                def worker():
                    try:
                        from complete.pipeline import complete_local
                        complete_local(
                            video,
                            source_url=row["source_url"],
                            topic=row["title"] or "source",
                            max_candidates=5,
                            run_id=run_id
                        )
                    except Exception as exc:
                        print("BUILD 20.3 ERROR:",repr(exc))

                threading.Thread(target=worker,daemon=True).start()

                HUDHandler.source_id=sid
                _json(self,200,{
                    "source_id":sid,
                    "run_id":run_id,
                    "state":"RUNNING"
                })
                return
            if parsed.path=="/api/upload":
                n=int(self.headers.get("Content-Length","0"))
                if n>1024*1024*1024: _json(self,413,{"error":"upload exceeds 1GB limit"}); return
                raw=self.rfile.read(n)
                content_type=self.headers.get("Content-Type","")
                msg=BytesParser(policy=default).parsebytes(("Content-Type: "+content_type+"\r\n\r\n").encode()+raw)
                file_part=next((p for p in msg.iter_parts() if p.get_filename()),None)
                if file_part is None: _json(self,400,{"error":"file field required"}); return
                purpose=next((p.get_content() for p in msg.iter_parts() if p.get_param("name",header="content-disposition")=="purpose"),"reference")
                tempdir=Path(self.db_path).resolve().parent/"clipping_farm_uploads"; tempdir.mkdir(parents=True,exist_ok=True)
                target=tempdir/(uuid.uuid4().hex+"_"+Path(file_part.get_filename()).name); target.write_bytes(file_part.get_payload(decode=True))
                sid=f"hud:{uuid.uuid4().hex[:12]}"; db.set_rights(sid,"AUTHORISED",{"basis":"explicit operator upload in local HUD"})
                result=SourceIngestor(db).ingest_file(Source(sid,str(target),"file",{"purpose":purpose}))
                HUDHandler.source_id=sid
                result["source_id"]=sid
                _json(self,200,result); return
            _json(self,404,{"error":"not found"})
        except Exception as exc:
            _json(self,500,{"error":f"{type(exc).__name__}: {exc}"})

    def log_message(self,*_): pass

def serve(db_path, source_id, host="127.0.0.1", port=8765):
    HUDHandler.db_path=db_path; HUDHandler.source_id=source_id
    server=ThreadingHTTPServer((host,port),HUDHandler)
    print(f"Clipping Farm HUD: http://{host}:{port}")
    print(f"Source/run: {source_id}")
    print("Press Ctrl-C to stop.")
    try: server.serve_forever()
    except KeyboardInterrupt: print("\nHUD stopped.")
    finally: server.server_close()


    "t": "kb",
    "src": "shark_okeanos.jpg",
    "z0": 1.22,
    "z1": 1.5,
    "cx": 0.68,
    "cy": 0.4
   },
   "gap": 0.15
  },
  {
   "id": "s8",
   "text": "It will keep going for another century. Blind, in the cold, two thousand metres down.",
